# OOPS! P11 (important): an object or datatype property without rdfs:domain or without rdfs:range.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?entity ?property ?value WHERE {
  VALUES ?type { owl:ObjectProperty owl:DatatypeProperty }
  ?entity a ?type .
  { FILTER NOT EXISTS { ?entity rdfs:domain ?d } BIND(rdfs:domain AS ?property) }
  UNION { FILTER NOT EXISTS { ?entity rdfs:range ?r } BIND(rdfs:range AS ?property) }
  BIND("missing" AS ?value)
}
