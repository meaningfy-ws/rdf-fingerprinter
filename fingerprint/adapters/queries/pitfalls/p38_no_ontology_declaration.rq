# id: p38_no_ontology_declaration
# title: No owl:Ontology declaration
# importance: important
# scope: schema
# source: OOPS! P38
# description: no owl:Ontology declaration.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?entity ?property ?value WHERE {
  FILTER NOT EXISTS { ?o a owl:Ontology }
  BIND(owl:Ontology AS ?entity) BIND(rdf:type AS ?property) BIND("no owl:Ontology in the file" AS ?value)
}
