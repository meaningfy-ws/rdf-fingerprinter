# id: p12_p30_same_name_not_equivalent
# title: Same local name in two namespaces, not declared equivalent
# importance: minor
# scope: schema
# source: OOPS! P12/P30
# heuristic: true
# description: OOPS! P12/P30 (important, approximation): two classes or properties with the same local name in different namespaces, not declared equivalent (OOPS! also uses labels and WordNet synonyms).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?entity ?property ?value WHERE {
  VALUES ?t { owl:Class owl:ObjectProperty owl:DatatypeProperty }
  ?entity a ?t . ?value a ?t . FILTER(isIRI(?entity) && isIRI(?value) && STR(?entity) < STR(?value))
  FILTER(LCASE(REPLACE(STR(?entity), "^.*[#/]", "")) = LCASE(REPLACE(STR(?value), "^.*[#/]", "")))
  FILTER NOT EXISTS { ?entity owl:equivalentClass|owl:equivalentProperty|^owl:equivalentClass|^owl:equivalentProperty ?value }
  BIND(?t AS ?property)
}
