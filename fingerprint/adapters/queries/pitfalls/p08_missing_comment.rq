# id: p08_missing_comment
# title: Class or property without a comment
# importance: minor
# scope: schema
# source: OOPS! P08
# description: a declared class or property without rdfs:label or without rdfs:comment.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?entity ?property ?value WHERE {
  VALUES ?type { owl:Class owl:ObjectProperty owl:DatatypeProperty }
  ?entity a ?type . FILTER(isIRI(?entity))
  FILTER NOT EXISTS { ?entity rdfs:comment ?c }
  BIND(rdfs:comment AS ?property) BIND("no rdfs:comment" AS ?value)
}
