# id: p07_merged_concepts
# title: Class name joins concepts with And/Or
# importance: minor
# scope: schema
# source: OOPS! P07
# heuristic: true
# description: a class whose local name joins concepts with And/Or (e.g. ContinuousIntegrationAndDeployment).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?entity ?property ?value WHERE {
  ?entity a owl:Class . FILTER(isIRI(?entity))
  BIND(REPLACE(STR(?entity), "^.*[#/]", "") AS ?value)
  FILTER(REGEX(?value, "[a-z](And|Or)[A-Z]|_(and|or)_")) BIND(rdf:type AS ?property)
}
