# id: resource_as_predicate
# title: Resource used as a predicate
# family: statement_identity
# A predicate with a type that is not a property type: the type is the relation (DEC-7). Property types of standard
# vocabularies (qb:, owl:*Property and their subclasses) never count as reifier types, nor do rdfs:Resource, owl:Thing and
# owl:NamedIndividual themselves (P-23).
# REIFY resource_as_predicate probe
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX qb: <http://purl.org/linked-data/cube#>
ASK { $graph_open ?s ?p ?o . ?p a ?t .
    FILTER NOT EXISTS { { VALUES ?np { rdf:Property rdfs:ContainerMembershipProperty
      owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty owl:OntologyProperty owl:DeprecatedProperty
      owl:FunctionalProperty owl:InverseFunctionalProperty owl:TransitiveProperty owl:SymmetricProperty
      owl:AsymmetricProperty owl:ReflexiveProperty owl:IrreflexiveProperty
      qb:DimensionProperty qb:MeasureProperty qb:AttributeProperty qb:CodedProperty qb:ComponentProperty } ?t rdfs:subClassOf* ?np } UNION { FILTER(?t IN (rdfs:Resource, owl:Thing, owl:NamedIndividual)) } }
    $graph_close }
# REIFY resource_as_predicate relations
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX qb: <http://purl.org/linked-data/cube#>
SELECT ?subjectClass ?predicate ?objectClass (COUNT(*) AS ?statements) WHERE {
  { SELECT $distinct ?s ?p ?o ?predicate WHERE { $graph_open ?s ?p ?o . ?p a ?predicate .
    FILTER NOT EXISTS { { VALUES ?np { rdf:Property rdfs:ContainerMembershipProperty
      owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty owl:OntologyProperty owl:DeprecatedProperty
      owl:FunctionalProperty owl:InverseFunctionalProperty owl:TransitiveProperty owl:SymmetricProperty
      owl:AsymmetricProperty owl:ReflexiveProperty owl:IrreflexiveProperty
      qb:DimensionProperty qb:MeasureProperty qb:AttributeProperty qb:CodedProperty qb:ComponentProperty } ?predicate rdfs:subClassOf* ?np } UNION { FILTER(?predicate IN (rdfs:Resource, owl:Thing, owl:NamedIndividual)) } }
    $graph_close } }
  $graph_open ?s a ?subjectClass . $graph_close
  OPTIONAL { $graph_open ?o a ?objectClass . $graph_close } }
GROUP BY ?subjectClass ?predicate ?objectClass
# REIFY resource_as_predicate reifier-properties
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX qb: <http://purl.org/linked-data/cube#>
SELECT ?subjectClass ?predicate ?objectClass ?reifierProperty (COUNT(DISTINCT ?p) AS ?reifiers) WHERE {
  $graph_open ?s ?p ?o . ?p a ?predicate ; ?reifierProperty ?v .
  FILTER NOT EXISTS { { VALUES ?np { rdf:Property rdfs:ContainerMembershipProperty
      owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty owl:OntologyProperty owl:DeprecatedProperty
      owl:FunctionalProperty owl:InverseFunctionalProperty owl:TransitiveProperty owl:SymmetricProperty
      owl:AsymmetricProperty owl:ReflexiveProperty owl:IrreflexiveProperty
      qb:DimensionProperty qb:MeasureProperty qb:AttributeProperty qb:CodedProperty qb:ComponentProperty } ?predicate rdfs:subClassOf* ?np } UNION { FILTER(?predicate IN (rdfs:Resource, owl:Thing, owl:NamedIndividual)) } }
  FILTER(?reifierProperty != rdf:type) ?s a ?subjectClass .
  OPTIONAL { ?o a ?objectClass } $graph_close }
GROUP BY ?subjectClass ?predicate ?objectClass ?reifierProperty
# REIFY resource_as_predicate hidden
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX qb: <http://purl.org/linked-data/cube#>
SELECT DISTINCT ?term WHERE { $graph_open
  { ?s ?p ?o . ?p a ?t .
    FILTER NOT EXISTS { { VALUES ?np { rdf:Property rdfs:ContainerMembershipProperty
      owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty owl:OntologyProperty owl:DeprecatedProperty
      owl:FunctionalProperty owl:InverseFunctionalProperty owl:TransitiveProperty owl:SymmetricProperty
      owl:AsymmetricProperty owl:ReflexiveProperty owl:IrreflexiveProperty
      qb:DimensionProperty qb:MeasureProperty qb:AttributeProperty qb:CodedProperty qb:ComponentProperty } ?t rdfs:subClassOf* ?np } UNION { FILTER(?t IN (rdfs:Resource, owl:Thing, owl:NamedIndividual)) } }
    BIND(?p AS ?term) }
  UNION { ?s ?p ?o . ?p a ?t .
    FILTER NOT EXISTS { { VALUES ?np { rdf:Property rdfs:ContainerMembershipProperty
      owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty owl:OntologyProperty owl:DeprecatedProperty
      owl:FunctionalProperty owl:InverseFunctionalProperty owl:TransitiveProperty owl:SymmetricProperty
      owl:AsymmetricProperty owl:ReflexiveProperty owl:IrreflexiveProperty
      qb:DimensionProperty qb:MeasureProperty qb:AttributeProperty qb:CodedProperty qb:ComponentProperty } ?t rdfs:subClassOf* ?np } UNION { FILTER(?t IN (rdfs:Resource, owl:Thing, owl:NamedIndividual)) } }
    BIND(?t AS ?term)
          FILTER NOT EXISTS { ?x a ?term FILTER NOT EXISTS { ?s2 ?x ?o2 } } }
  $graph_close }
