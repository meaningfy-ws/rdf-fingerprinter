{#- One PlantUML file: a graph's overview, or one module of it. `view` is a DiagramOverview or a DiagramModule
    (model/fingerprint_views.yaml), told apart by `view.kind`; names, multiplicities and arrows come ready from the
    generator (fingerprint/service_layer/generators/plantuml.py); this template only lays them out. -#}
@startuml
{%- if view.kind == "overview" %}
title {{ conf.title }} — {{ view.graph_label }} — overview
{% for p in view.packages %}
package "{{ p.prefix }} ({% if p.referenced %}referenced{% else %}{{ p.classes }} classes{% endif %})" as {{ p.alias }} {
{%- for m in p.modules %}
  [{{ m }}]
{%- endfor %}
}
{%- endfor %}
{% for l in view.links %}
{{ l.source }} --> {{ l.target }} : {{ l.count }}
{%- endfor %}
{%- else %}
title {{ conf.title }} — {{ view.graph_label }} — {{ view.name }}
hide empty members
{% for cls in view.classes %}
class "{{ cls.label }}" as {{ cls.alias }} {
{%- for m in cls.members if m.kind == "attribute" %}
  {{ m.text }}
{%- endfor %}
}
{%- endfor %}
{% for box in view.reference_boxes %}
class "{{ box.label }}" as {{ box.alias }} #lightgray
{%- endfor %}
{% for cls in view.classes %}
{%- for line in cls.generalisations %}
{{ line }}
{%- endfor %}
{%- for m in cls.members if m.kind == "association" %}
{{ cls.alias }} --> {{ m.text }}
{%- endfor %}
{%- endfor %}
{%- endif %}
@enduml
