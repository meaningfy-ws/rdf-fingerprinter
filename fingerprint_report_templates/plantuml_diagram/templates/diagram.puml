{#- One class diagram per graph. `view` is a DiagramGraph (model/fingerprint_views.yaml): names,
    multiplicities and arrows come ready from the generator
    (fingerprint/service_layer/generators/plantuml.py); this template only lays them out. -#}
@startuml
title {{ conf.title }} — {{ view.graph_label }}
hide empty members
{% for cls in view.classes %}
class "{{ cls.label }}" as {{ cls.alias }} {
{%- for m in cls.members if m.kind == "attribute" %}
  {{ m.text }}
{%- endfor %}
}
{%- endfor %}
{% for box in view.parent_boxes %}
class "{{ box.label }}" as {{ box.alias }}
{%- endfor %}
{% for cls in view.classes %}
{%- for line in cls.generalisations %}
{{ line }}
{%- endfor %}
{%- for m in cls.members if m.kind == "association" %}
{{ cls.alias }} --> {{ m.text }}
{%- endfor %}
{%- endfor %}
@enduml
