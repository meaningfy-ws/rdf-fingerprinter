[importlinter]
root_packages =
    fingerprint
    tests
# Needed by the external-packages contract below.
include_external_packages = True

# Onion layers (DEC-7, P-10): a layer may import only the layers below it.
[importlinter:contract:layers]
name = fingerprint layers
type = layers
layers =
    fingerprint.entrypoints
    fingerprint.service_layer
    fingerprint.adapters
    fingerprint.domain

# Lists, not patterns: a new module under fingerprint.domain must be added to this contract.
[importlinter:contract:generated]
name = generated model imports no project code
type = forbidden
source_modules =
    fingerprint.domain.profile
    fingerprint.domain.views
forbidden_modules =
    fingerprint.domain.profile
    fingerprint.domain.iri
    fingerprint.domain.analytics
    fingerprint.domain.exceptions
    fingerprint.domain.vocabulary
    fingerprint.domain.prefixes
    fingerprint.domain.modules
    fingerprint.domain.shapes
    fingerprint.domain.pitfalls
    fingerprint.adapters
    fingerprint.service_layer
    fingerprint.entrypoints

[importlinter:contract:pure-domain]
name = domain imports no I/O library
type = forbidden
source_modules =
    fingerprint.domain
forbidden_modules =
    eds4jinja2
    jinja2
    rdflib
    click

# I/O libraries are reached only through adapters (profile-representations P-12). Indirect imports
# are allowed: handlers builds the default SPARQL client, which imports rdflib itself. Collection reads
# the client's rdflib result rows and tells blank nodes by their term class (domain-object-model P-8).
[importlinter:contract:service-io]
name = service layer imports no I/O library itself
type = forbidden
source_modules =
    fingerprint.service_layer
forbidden_modules =
    jinja2
    eds4jinja2
    rdflib
allow_indirect_imports = True
ignore_imports =
    fingerprint.service_layer.collection -> rdflib

# Test fences (lean-test-suite P-4): each tier imports only the layers it tests, and the shared
# support modules know no tier. Indirect imports count.
[importlinter:contract:tests-domain]
name = domain tests import no higher layer or test double
type = forbidden
source_modules =
    tests.unit.domain
forbidden_modules =
    fingerprint.adapters
    fingerprint.service_layer
    fingerprint.entrypoints
    tests.fakes

[importlinter:contract:tests-adapters]
name = adapter tests import no service layer or entrypoint
type = forbidden
source_modules =
    tests.unit.adapters
forbidden_modules =
    fingerprint.service_layer
    fingerprint.entrypoints

[importlinter:contract:tests-service-layer]
name = service-layer tests import no entrypoint
type = forbidden
source_modules =
    tests.unit.service_layer
forbidden_modules =
    fingerprint.entrypoints

[importlinter:contract:tests-data]
name = sample data and builders build model objects only
type = forbidden
source_modules =
    tests.builders
    tests.sample_data
forbidden_modules =
    fingerprint.adapters
    fingerprint.service_layer
    fingerprint.entrypoints

[importlinter:contract:tests-support]
name = shared test support imports no test tier
type = forbidden
source_modules =
    tests.conftest
    tests.sample_data
    tests.builders
    tests.fakes
forbidden_modules =
    tests.unit
    tests.bdd
    tests.e2e
    tests.guards

[importlinter:contract:tests-independence]
name = test tiers are independent
type = independence
modules =
    tests.unit
    tests.bdd
    tests.e2e
    tests.guards
