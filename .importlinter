[importlinter]
root_package = fingerprint
# Needed by the external-packages contract below.
include_external_packages = True

# Onion layers (DEC-7, P-10): a layer may import only the layers below it.
[importlinter:contract:layers]
name = fingerprint layers
type = layers
layers =
    fingerprint.entrypoints
    fingerprint.service_layer
    fingerprint.adapters
    fingerprint.domain

# Lists, not patterns: a new module under fingerprint.domain must be added to this contract.
[importlinter:contract:generated]
name = generated model imports no project code
type = forbidden
source_modules =
    fingerprint.domain.profile
    fingerprint.domain.views
forbidden_modules =
    fingerprint.domain.profile
    fingerprint.domain.iri
    fingerprint.domain.analytics
    fingerprint.domain.exceptions
    fingerprint.domain.vocabulary
    fingerprint.domain.prefixes
    fingerprint.domain.modules
    fingerprint.domain.shapes
    fingerprint.domain.pitfalls
    fingerprint.adapters
    fingerprint.service_layer
    fingerprint.entrypoints

[importlinter:contract:pure-domain]
name = domain imports no I/O library
type = forbidden
source_modules =
    fingerprint.domain
forbidden_modules =
    eds4jinja2
    jinja2
    rdflib
    click

# I/O libraries are reached only through adapters (profile-representations P-12). Indirect imports
# are allowed: handlers builds the default SPARQL client, which imports rdflib itself. Collection reads
# the client's rdflib result rows and tells blank nodes by their term class (domain-object-model P-8).
[importlinter:contract:service-io]
name = service layer imports no I/O library itself
type = forbidden
source_modules =
    fingerprint.service_layer
forbidden_modules =
    jinja2
    eds4jinja2
    rdflib
allow_indirect_imports = True
ignore_imports =
    fingerprint.service_layer.collection -> rdflib
