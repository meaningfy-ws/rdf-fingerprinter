# Protocol method stubs (`def ...: ...`) are signatures, not branches.
[run]
relative_files = True
# sys.monitoring tracer: the default tracer makes the pandas-heavy report runs ~12x slower
core = sysmon
source = fingerprint
omit = */__init__.py

[report]
show_missing = true
exclude_lines =
    pragma: no cover
    ^\s*def .*: \.\.\.$
    if __name__ == .__main__.:
