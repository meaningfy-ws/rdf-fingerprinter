# SHACL shapes inferred by rdf-fingerprinter — default graph

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix euvoc-shape: <http://publications.europa.eu/ontology/euvoc/shape/> .
@prefix fp: <https://data.meaningfy.ws/fingerprint/> .
@prefix lvont: <http://lexvo.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skos-shape: <http://www.w3.org/2004/02/skos/core/shape/> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix skosxl-shape: <http://www.w3.org/2008/05/skos-xl/shape/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

euvoc-shape:Continent a sh:NodeShape ;
    sh:targetClass euvoc:Continent ;
    fp:instances 6 ;
    fp:observedInstances 6 ;
    fp:precisionMode "exact" ;
    sh:property euvoc-shape:Continent-euvoc-startDate ;
    sh:property euvoc-shape:Continent-euvoc-status ;
    sh:property euvoc-shape:Continent-euvoc-xlNotation ;
    sh:property euvoc-shape:Continent-dcterms-created ;
    sh:property euvoc-shape:Continent-skos-inScheme ;
    sh:property euvoc-shape:Continent-skos-topConceptOf ;
    sh:property euvoc-shape:Continent-skosxl-prefLabel ;
.

euvoc-shape:Continent-euvoc-startDate a sh:PropertyShape ;
    sh:path euvoc:startDate ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:nodeKind sh:Literal ;
    fp:confidence 1.0 ;
    fp:labelSupport 1.0 ;
.

euvoc-shape:Continent-euvoc-status a sh:PropertyShape ;
    sh:path euvoc:status ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    fp:confidence 1.0 ;
    fp:labelSupport 1.0 ;
.

euvoc-shape:Continent-euvoc-xlNotation a sh:PropertyShape ;
    sh:path euvoc:xlNotation ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class euvoc:XlNotation ;
    sh:nodeKind sh:BlankNode ;
    fp:confidence 1.0 ;
    fp:labelSupport 1.0 ;
.

euvoc-shape:Continent-dcterms-created a sh:PropertyShape ;
    sh:path dcterms:created ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:date ;
    sh:nodeKind sh:Literal ;
    fp:confidence 1.0 ;
    fp:labelSupport 1.0 ;
.

euvoc-shape:Continent-skos-inScheme a sh:PropertyShape ;
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:class owl:Ontology ] [ sh:class skos:ConceptScheme ] ) ;
    sh:nodeKind sh:IRI ;
    fp:confidence 1.0 ;
    fp:labelSupport 1.0 ;
.

euvoc-shape:Continent-skos-topConceptOf a sh:PropertyShape ;
